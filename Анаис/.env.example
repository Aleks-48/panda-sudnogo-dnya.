PORT=3000
# OpenAI-compatible Chat Completions endpoint; keys are used on the server only.
LLM_URL=
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
# Optional signed organizer URL (never commit actual URL).
DATASET_URL=
# Optional USD per million tokens, for your selected provider/model.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0

# Optional: compatible (default), groq, gemini, ollama
LLM_PROVIDER=compatible
# Local service: LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# For a local endpoint, LLM_API_KEY can be empty. Set the installed model in LLM_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Optional OpenAI-compatible request controls, supported by the selected model:
LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=4096
# Approximate Standard rates for gpt-6-luna on 2026-11-07: input 0.10 / output 0.50 USD per 1M tokens.
# Set the price fields above from your actual provider tariff before estimating cost.
