# Выбор провайдера ИИ: 'auto' (по умолчанию) | 'gemini' | 'groq' | 'ollama' | 'mock'
LLM_PROVIDER=mock

# Бесплатный ключ Google AI Studio (модель настраивается через GEMINI_MODEL):
GEMINI_API_KEY=

# Бесплатный ключ Groq (Llama 3.3 70B Free Tier):
GROQ_API_KEY=

# Локальная модель Ollama (если развернута локально):
OLLAMA_URL=http://localhost:11434

GEMINI_MODEL=gemini-2.5-flash
# Оставить false до получения официального правила фатальной ошибки
FATAL_ZERO_TOTAL=false

# Model selection (local Ollama or explicitly approved cloud)
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen2.5:7b
